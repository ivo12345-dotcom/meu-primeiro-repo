<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:name=".RodadoApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Rodado">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Rodado">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              Regresso do login da Tesla.

              A Tesla so aceita enderecos de retorno em https, por isso nao da
              para usar um esquema proprio da app. Enquanto nao houver um dominio
              configurado, o login termina com o codigo copiado a mao a partir da
              pagina de retorno; assim que houver, basta acrescentar aqui o
              intent-filter do App Link para o passo passar a ser automatico.
            -->
        </activity>
    </application>
</manifest>
